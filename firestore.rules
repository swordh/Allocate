rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────────────────
    // Users may read their own profile. All writes are via Cloud Functions only.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Memberships ───────────────────────────────────────────────────────────
    // Users may read their own membership documents (needed for company switcher).
    // All writes are via Cloud Functions only — prevents self-elevation to admin.
    match /users/{userId}/memberships/{companyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Company root document ─────────────────────────────────────────────────
    // All company writes are via Cloud Functions only.
    // Subscription state is Stripe's source of truth and must never be
    // written directly by a client.
    match /companies/{companyId} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false;
    }

    // ── Equipment ─────────────────────────────────────────────────────────────
    // All writes are via Cloud Functions only (addEquipment, updateEquipment,
    // deactivateEquipment). The client never writes equipment documents directly.
    match /companies/{companyId}/equipment/{equipmentId} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false; // Cloud Functions only
    }

    // ── Equipment units subcollection (collectionGroup access) ───────────────
    // collectionGroup('units') queries cannot match path-specific rules.
    // This wildcard rule enables client-side real-time listeners while keeping
    // tenant isolation via the denormalized companyId field on each unit doc.
    match /{path=**}/units/{unitId} {
      // companyId MUST be present on every unit document.
      // If absent (e.g. bad migration), this rule safely denies access (undefined != activeCompanyId).
      // createUnit (actions/equipment.ts ~407) and createEquipmentWithUnits (~620) both always set it.
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == resource.data.companyId;
      allow write: if false;
    }

    // ── Equipment units subcollection ─────────────────────────────────────────
    // Physical unit documents live under equipment/{equipmentId}/units/{unitId}.
    // All writes are via Server Actions (Admin SDK) only.
    match /companies/{companyId}/equipment/{equipmentId}/units/{unitId} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false;  // Server Actions (admin SDK) only
    }

    // ── Categories ────────────────────────────────────────────────────────────
    // All writes are via Cloud Functions only (addCategory, seeded by createCompany).
    match /companies/{companyId}/categories/{categoryId} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false; // Cloud Functions only
    }

    // ── Bookings ───────────────────────────────────────────────────────────────
    // All writes are via Cloud Functions only (createBooking, updateBooking,
    // cancelBooking, approveBooking, rejectBooking, updateBookingStatus).
    // The companyId claim check ensures tenant isolation — a user can only read
    // bookings for the company they are currently active in.
    match /companies/{companyId}/bookings/{bookingId} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false; // Cloud Functions only
    }

    // ── Nested company data (fallback for future subcollections) ──────────────
    // Covers any subcollection not yet given its own explicit rule above.
    // Phase 3 will add a specific bookings rule (crew can create their own).
    // This wildcard must remain as a safe fallback — read for members, no writes.
    match /companies/{companyId}/{document=**} {
      allow read: if request.auth != null
                  && request.auth.token.activeCompanyId == companyId;
      allow write: if false; // Default: all writes via Cloud Functions
    }

    // ── Stripe event deduplication log ────────────────────────────────────────
    // Written only by the webhook Cloud Function. Never readable by clients.
    match /_stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ── GDPR deletion audit log ───────────────────────────────────────────────
    // Never readable by clients — only ever written by the Admin SDK. Four
    // row shapes, all governed by the same 12-month retention rule
    // (functions/src/admin/purgeAuditLogs.ts), from three writers:
    //   - `actions/account.ts` (deleteAccount) — self-service deletion, `deletedAt`.
    //   - `functions/src/company/memberCleanup.ts` — a stranded member's
    //     account-deletion SCHEDULE, `scheduledAt` (issue #252 step 5).
    //   - `functions/src/company/strandedAccountSweep.ts` — that schedule's
    //     enforcement sweep, either fulfilling it (`deletedAt`) or clearing it
    //     because a live membership was found (`clearedAt`, issue #252 step 6).
    //   - `actions/account.ts`'s `writeDeletionFailureAudit` — a FAILED
    //     self-service deletion attempt, `failedAt` (issue #358). Written
    //     standalone from each phase's `catch` block, never as part of the
    //     WriteBatch that just failed. Carries `outcome: 'failed'`,
    //     `failedStep` ('membership_removal' | 'anonymisation' |
    //     'auth_delete'), `errorCode` (never the error message — may contain
    //     PII), and `completedCompanies`/`totalCompanies`. No name, no email,
    //     same as every other shape here.
    match /deletionAuditLog/{logId} {
      allow read, write: if false;
    }

    // ── Account deletion failure trace (issue #337) ───────────────────────────
    // One doc per uid, `accountDeletionFailures/{uid}` — a minimal, durable
    // trace of a self-service `deleteAccount` (actions/account.ts) that
    // returned "could not verify, try again" instead of succeeding. Before
    // this, that outcome left nothing behind but a `console.error` line in
    // App Hosting's 30-day log retention, with no way for an operator to see
    // who was stuck or how often. Written and cleared only by the Admin SDK
    // — never readable or writable by a client:
    //   firstAt, lastAt: Timestamp
    //   attempts: number
    //   lastPath: 'lock_acquire' | 'preflight_read' | 'preflight_unknown' |
    //             'commit_loop' | 'memberships_read'
    //   lastErrorCode: string | null
    //   lastCompanyIds: string[]   // companies involved in the last failure —
    //                              // may point at a company purged since this
    //                              // was written; a dead link in the operator
    //                              // view for that id is expected, not a bug.
    //   expireAt: Timestamp        // TTL field, 90 days from lastAt
    // Raw uid, not a hash like `deletionAuditLog`'s `userIdHash` — the whole
    // point is that an operator can look up the person who's stuck. No name,
    // no email. Deleted outright the moment a deletion for that uid actually
    // succeeds; `expireAt` is only the backstop for a uid that never retries
    // and never succeeds either.
    match /accountDeletionFailures/{uid} {
      allow read, write: if false;
    }

    // ── Operator access (issue #344) ──────────────────────────────────────────
    // Operator status is a plain doc, not a custom claim or an allowlist —
    // see lib/operator-dal.ts's isOperator() for why. Written and read only
    // by the Admin SDK: `getOperatorSession`/`operatorSignIn` read it,
    // tools/set-operator.js writes it. Never client-readable — a client that
    // could read its own doc could also infer operator status of others via
    // existence checks, and there is no legitimate client use case anyway.
    //   email: string
    //   grantedAt: Timestamp
    match /operators/{uid} {
      allow read, write: if false;
    }

    // ── Operator login audit log (issue #344) ─────────────────────────────────
    // Append-only, never client-readable. One row per attempt to authenticate
    // against /operator/login — both operators who succeed and anyone else
    // who tries (legitimate interest: security). Written only by
    // actions/operator-auth.ts via the Admin SDK, before a session cookie is
    // ever issued — "no access without an audit trail".
    //   uid: string
    //   email: string
    //   outcome: 'granted' | 'denied'
    //   reason: string
    //   at: Timestamp
    //   expireAt: Timestamp        // TTL field, 12 months from `at`
    // No IP address, no user agent — deliberately out of scope, see
    // lib/operator-login-log.ts.
    match /operatorLoginLog/{id} {
      allow read, write: if false;
    }

    // ── Invitation mirror (public bearer-token lookup) ────────────────────────
    // Top-level mirror at invitations/{token}. The token is an unguessable random
    // id that acts as a bearer secret, so a single-document `get` is public — this
    // lets the signup form validate a pasted invite link/code client-side.
    // `list` is denied to prevent enumeration; all writes are Admin SDK only.
    match /invitations/{token} {
      allow get: if true;
      allow list, write: if false;
    }

    // ── Outbound email queue ──────────────────────────────────────────────────
    // Written by server actions / Cloud Functions (Admin SDK) and consumed by the
    // onMailQueued trigger. Contains recipient addresses (PII) — never client-readable.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ── operatorNotes / companyEvents (no rule — intentional) ─────────────────
    // Both are top-level collections written only via the Admin SDK from
    // app/operator/customers/[companyId]/actions.ts and the Stripe webhook.
    // Neither gets an explicit rule here, same as `operatorFeedback` above it:
    // a top-level collection with no matching rule is default-deny under
    // Firestore Security Rules — there is no wildcard in this file that could
    // accidentally cover it (the only broad wildcards are scoped under
    // `companies/{companyId}/{document=**}` and `{path=**}/units/{unitId}`,
    // neither of which matches a top-level path segment named `operatorNotes`
    // or `companyEvents`). This is the fix for the hole `opsNotes` had as a
    // field on `companies/{id}`: that document IS readable by any member with
    // a matching `activeCompanyId`, so the operator's private notes about a
    // customer were readable by that customer. A top-level collection has no
    // such membership rule to inherit.

    // ── companyDeletions / companyDeletionCancelTokens (no rule — intentional) ─
    // Issue #252, step 5. Same reasoning as `operatorNotes`/`companyEvents`
    // directly above, and the same absent-rule-is-default-deny mechanism: a
    // top-level collection with no matching rule here is denied entirely,
    // and neither name matches the `companies/{companyId}/{document=**}` or
    // `{path=**}/units/{unitId}` wildcards, so nothing accidentally exposes
    // them.
    //
    // `companyDeletions/{requestId}` is the deletion audit/progress ledger.
    // It carries operator notes and internal lease/retry state that must
    // never be member-readable, and it is written only by Cloud Functions
    // and by `app/operator/...` server actions (Admin SDK) — never by a
    // client. See the docblock on `CompanyDeletionRecord` in
    // types/company.ts for the full rationale, including why it is
    // top-level rather than nested under `companies/{cid}` (it must survive
    // the company document itself being deleted).
    //
    // `companyDeletionCancelTokens/{token}` are bearer secrets mailed only
    // to admins so they can cancel a pending deletion from an email link
    // without being signed in. If this collection had a rule at all — and
    // especially if it were nested under `companies/{cid}`, where it would
    // inherit the wildcard above — any member, crew included, could read or
    // guess another admin's cancel token and cancel a deletion they have no
    // authority over. The verifying/consuming code path (PR F) reads these
    // with the Admin SDK, never the client SDK, so no rule is ever needed.
    //
    // This absence is a documented decision, not a gap to "fix" later.
  }
}
